BINANCE_API_KEY=
BINANCE_API_SECRET=
TG_BOT_TOKEN=
TG_CHAT_ID=

ARB_DRY_RUN_BINANCE=true
# Required in live mode: I_ACCEPT_LIVE_TRADING
BINANCE_LIVE_ACK=
ARB_START_CURRENCIES_BINANCE=USDT,USDC,FDUSD,BTC,ETH,BNB,EUR,TRY,BRL,JPY,MXN,ZAR
# IDR markets were rejected by this account; exclude restricted bridge assets.
ARB_EXCLUDED_ASSETS_BINANCE=IDR
ARB_MIN_NET_BPS_BINANCE=10
BALANCE_SHARE_TO_BID_BINANCE=1.00
ARB_MIN_SIZE_SHARE_BINANCE=0.10
ARB_MAX_SLIPPAGE_BPS_BINANCE=15
ARB_SCAN_INTERVAL_MS_BINANCE=100
ARB_TICKER_MAX_AGE_S_BINANCE=2
# Maximum observation-time separation across a route's quotes or depth books.
ARB_QUOTE_MAX_SKEW_S_BINANCE=0.5
ARB_REST_SEED_INTERVAL_S_BINANCE=15
ARB_CONFIRMATION_CANDIDATES_PER_START_BINANCE=3
ARB_CONFIRMATION_CANDIDATES_TOTAL_BINANCE=12
ARB_SCAN_LOG_INTERVAL_S_BINANCE=10
ARB_AUTO_RECOVER_BINANCE=true
ARB_ARCHIVE_RETENTION_DAYS_BINANCE=30
ARB_ARCHIVE_MAX_FILES_BINANCE=2000
# Binance validates BNB discount eligibility with a non-executing order-test probe.
ARB_USE_BNB_FEE_DISCOUNT_BINANCE=false
# Enable only after choosing an operational reserve policy for live trading.
ARB_BNB_REPLENISH_ENABLED_BINANCE=false
ARB_BNB_REPLENISH_FLOOR_USDT_BINANCE=3
ARB_BNB_REPLENISH_TARGET_USDT_BINANCE=10
